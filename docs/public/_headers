# Cloudflare Pages headers — copied verbatim into the build output root.
# Long-cache the content-hashed VitePress assets; they never change in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The news feed the app's start page and the What's new page read; open to
# other sites, short cache.
/news.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Sensible defaults for every page.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
